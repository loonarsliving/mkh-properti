# Salin menjadi .env.local untuk pengembangan lokal.
# JANGAN commit .env.local — sudah masuk .gitignore.

# ── Supabase ───────────────────────────────────────────────────────────
# Keduanya opsional: bila kosong, aplikasi memakai nilai bawaan yang sama
# dengan yang dipakai halaman HTML lama (lihat src/lib/config.ts).
# Anon key memang dirancang untuk terekspos di sisi klien.
NEXT_PUBLIC_SUPABASE_URL=https://gluoioiimapyhchdasfl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Notifikasi Telegram (opsional) ─────────────────────────────────────
# Dipakai hanya untuk event HR/payroll/komisi hasil sinkronisasi MK Connect.
# Bila dikosongkan, notifikasi dilewati dan approval tetap berjalan normal.
#
# PERINGATAN: variabel NEXT_PUBLIC_* ikut masuk ke bundle browser, jadi token
# di sini TIDAK rahasia. Ini hanya mencegah token ter-commit ke repositori.
# Solusi yang benar adalah memindahkan pengiriman notifikasi ke Edge Function.
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
